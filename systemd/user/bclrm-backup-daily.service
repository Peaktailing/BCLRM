[Unit]
Description=BCLRM prod 每日在线备份（SQLite backup API + 附件）
After=network.target

[Service]
Type=oneshot
EnvironmentFile=-/home/biochm/BCLRM/env/prod.env
ExecStart=/home/biochm/BCLRM/current_prod/.venv/bin/python /home/biochm/BCLRM/current_prod/payload/scripts/backup.py --root /home/biochm/BCLRM --env prod --kind daily --mode hot --source timer
# 备份成功后立即归档到异地；失败会让本 unit 失败，不静默跳过
ExecStartPost=/usr/bin/python3 /home/biochm/BCLRM/ops/offsite_sync.py --root /home/biochm/BCLRM --ssh-key /home/biochm/.ssh/id_ed25519_13 --env prod --json
