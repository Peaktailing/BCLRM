[Unit]
Description=BCLRM beta 每日快照（beta 可丢弃，保留 2 份）
After=network.target

[Service]
Type=oneshot
EnvironmentFile=-/home/biochm/BCLRM/env/beta.env
ExecStart=/home/biochm/BCLRM/current_beta/.venv/bin/python /home/biochm/BCLRM/current_beta/payload/scripts/backup.py --root /home/biochm/BCLRM --env beta --kind daily --mode hot --source timer
ExecStartPost=/usr/bin/python3 /home/biochm/BCLRM/ops/offsite_sync.py --root /home/biochm/BCLRM --ssh-key /home/biochm/.ssh/id_ed25519_13 --env beta --json
